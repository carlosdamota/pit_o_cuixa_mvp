# Pit o Cuixa — Environment Configuration
# Copy to .env and fill in values for your environment.
# NEVER commit .env to version control.

# Application environment: dev|prod|test
APP_ENV=prod

# Absolute path to SQLite database file (outside public/ docroot)
DB_PATH=./data/pitocuixa.db

# Base site URL (no trailing slash)
SITE_URL=https://pitocuixa.es

# Shop domain where products can be ordered (no trailing slash)
URL_PRODUCT=https://pitocuixa.last.shop

# Session token lifetime in seconds (default: 8 hours = 28800)
SESSION_LIFETIME=28800

# Default locale: ca|es|en
# Default es, directriz dada por cliente. 
DEFAULT_LOCALE=es

# Service credential used by the unattended cron sync (scripts/cron-sync.php)
# against POST /api/update-menu. Empty = fail closed: sync routes reject every
# request until a token is configured. Rotation = changing this one value.
# Generate with: php -r "echo bin2hex(random_bytes(64));"
SERVICE_API_TOKEN=

# DeepL API key for automatic translations (scripts/translate.php)
# Leave empty to disable translation features.
# Get your key at https://www.deepl.com/pro-api
DEEPL_API_KEY=

#Token 2FA
TOTP_ENC_KEY=